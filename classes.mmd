
classDiagram
direction TB

class Сотрудник {
    -int id
    -String имя
    -String роль
    +запроситьБронь() void
}

class Аудитория {
    -String номер
    -int вместимость
    -String корпус
    +свободна(начало, конец) bool
    +получитьНомер() String
}

class Бронь {
    -int id
    -DateTime начало
    -DateTime конец
    -String цель
    +пересекаетсяС(другая) bool
    +отменить() void
}

class Расписание {
    -String период
    -DateTime датаОбновления
    -List аудитории
    +получитьЗанятость(начало, конец) List
}

class СервисБронирования {
    -List брони
    -String версия
    -String правила
    +найтиСвободные(начало, конец) List
    +создатьБронь(аудитория, сотрудник) Бронь
}

class ХранилищеБроней {
    -List брони
    +сохранить(бронь) bool
}

class СервисУведомлений {
    -List очередь
    +отправить(сообщение) bool
}

Сотрудник "1" -- "0..*" Бронь
